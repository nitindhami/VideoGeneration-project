# CineShorts AI Configuration

# 1. LLM Settings (Google Gemini or OpenAI)
# If neither is set, the system runs with intelligent built-in heuristic viral templates
GEMINI_API_KEY=
# OPENAI_API_KEY=

# 2. Text-to-Speech Settings
# Default is 'edge-tts' which is 100% FREE, requires zero keys, and provides high-quality neural voices
TTS_PROVIDER=edge-tts
# Set ELEVENLABS_API_KEY if you wish to use ElevenLabs voices
ELEVENLABS_API_KEY=

# 3. Visual Generation Provider
# Options: pollinations (free Flux/SDXL, no key needed), gemini (uses GEMINI_API_KEY), replicate, mock
IMAGE_PROVIDER=pollinations
# REPLICATE_API_TOKEN=

# 4. Storage & Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
STORAGE_DIR=./storage
