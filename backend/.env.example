# =============================================================================
# CineShorts AI — Production Environment Configuration
# Copy this file to .env and fill in your API keys
# =============================================================================

# ── Gemini / Google AI (RECOMMENDED — unlocks LLM + Image + TTS + Research) ─
GEMINI_API_KEY=AIza...

# ── Alternative LLM providers (optional, auto-detected) ──────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Image generation providers ────────────────────────────────────────────────
# IMAGE_PROVIDER: auto | gemini-3 | imagen-ultra | replicate | pollinations
IMAGE_PROVIDER=auto

# Replicate (alternative paid images ~$0.04/img via Flux 1.1 Pro)
REPLICATE_API_TOKEN=r8_...

# ── TTS providers ─────────────────────────────────────────────────────────────
# TTS_PROVIDER: auto | gemini-tts | elevenlabs | edge-tts
TTS_PROVIDER=auto

# ElevenLabs (professional voices with emotion control)
ELEVENLABS_API_KEY=sk_...

# ── Video editing settings ───────────────────────────────────────────────────
# EDIT_STYLE: fast_cuts | hybrid | cinematic
EDIT_STYLE=fast_cuts

# IMAGES_PER_SCENE: 1 (economy) | 2 (production) | 3 (ultra)
IMAGES_PER_SCENE=2

# IMAGE_QUALITY: economy | production | ultra
IMAGE_QUALITY=production

# ── Research settings ─────────────────────────────────────────────────────────
# DEEP_RESEARCH_ENABLED: true (uses Gemini Deep Research ~$1-3/run) | false
DEEP_RESEARCH_ENABLED=false

# ── Audio mixing ──────────────────────────────────────────────────────────────
MUSIC_ENABLED=true
MUSIC_VOLUME_DB=-18
VOICE_VOLUME_DB=-6

# ── Storage paths (defaults work out of the box) ─────────────────────────────
# OUTPUT_DIR=./storage/outputs
# TEMP_DIR=./storage/temp

# ── Cost estimates per video ──────────────────────────────────────────────────
# Economy (free):    $0      — Edge-TTS + Pollinations + 1 img/scene
# Production:        ~$0.50  — Gemini 2.5 Pro + Gemini TTS + 2 imgs/scene
# Ultra:             ~$2-5   — Deep Research + Gemini 3 Pro Image + 3 imgs/scene
